PORT=5000
NODE_ENV=development

# PostgreSQL connection string (required)
# Local:   postgresql://postgres:password@localhost:5432/jobhuntgenie
# Render:  Set automatically via render.yaml
DATABASE_URL=postgresql://user:password@localhost:5432/jobhuntgenie

# Salary Range (USD)
MIN_SALARY_USD=150000
MAX_SALARY_USD=300000

# Salary Range (INR)
MIN_SALARY_INR=3000000
MAX_SALARY_INR=6000000

# Target Job Titles (comma-separated)
TARGET_JOBS=Software Engineer 2,Senior Software Engineer,Senior Backend Engineer,Full Stack Engineer,Node.js Engineer,React Engineer,Ruby on Rails Engineer,Frontend Engineer,TypeScript Engineer,Backend Developer,Frontend Developer,Software Engineer

# Resume Paths (fallback for local dev — upload via dashboard on Render)
RESUME_INPUT_PATH=./resume/Resume.pdf
RESUME_OUTPUT_DIR=./resumes_output

# Cron Schedule (default: 9am daily)
SCRAPE_SCHEDULE=0 9 * * *

# Scraper Flags (1=enabled, 0=disabled)
SCRAPE_DICE=1
SCRAPE_INDEED=1
SCRAPE_GLASSDOOR=1
SCRAPE_WWR=1
SCRAPE_REMOTECO=1
SCRAPE_LINKEDIN=0
