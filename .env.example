PORT=5000
NODE_ENV=development

# Salary Range (USD)
MIN_SALARY_USD=150000
MAX_SALARY_USD=300000

# Salary Range (INR)
MIN_SALARY_INR=3000000
MAX_SALARY_INR=6000000

# Target Job Titles (comma-separated)
TARGET_JOBS=SWE-2,Senior Backend Engineer,Platform Engineer

# Resume Paths
RESUME_INPUT_PATH=./resume/Resume.pdf
RESUME_OUTPUT_DIR=./resumes_output

# Cron Schedule (default: 9am daily)
SCRAPE_SCHEDULE=0 9 * * *

# Scraper Flags (1=enabled, 0=disabled)
SCRAPE_DICE=1
SCRAPE_INDEED=1
SCRAPE_LINKEDIN=0
